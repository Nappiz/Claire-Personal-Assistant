  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 24000,
            "minLength": 1,
            "title": "Message",
            "description": "Pesan dari user"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "ID sesi untuk tracking history. Kosongkan untuk memulai sesi baru."
          },
          "turn_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36,
                "minLength": 36,
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Model ID spesifik jika ingin menimpa default"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "Provider API (google, groq, openai)"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id",
            "description": "Scope project untuk sesi baru"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply",
            "description": "Balasan dari Claire AI"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "ID sesi obrolan (dikembalikan untuk dipakai di request selanjutnya)"
          },
          "turn_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id",
            "description": "ID durable untuk retry idempotent turn ini"
          },
          "response_status": {
            "type": "string",
            "enum": [
              "complete",
              "incomplete"
            ],
            "title": "Response Status",
            "default": "complete"
          },
          "finish_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finish Reason"
          },
          "context_used": {
            "$ref": "#/components/schemas/MemoryContext",
            "description": "Konteks memori yang berhasil ditarik"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "session_id"
        ],
        "title": "ChatResponse"
      },
      "ConversationPinUpdate": {
        "properties": {
          "is_pinned": {
            "type": "boolean",
            "title": "Is Pinned"
          }
        },
        "type": "object",
        "required": [
          "is_pinned"
        ],
        "title": "ConversationPinUpdate"
      },
      "GraphFactUpdate": {
        "properties": {
          "is_current": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Current"
          },
          "importance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Importance"
          }
        },
        "type": "object",
        "title": "GraphFactUpdate"
      },
      "GraphNodeUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "identity_context": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Identity Context"
          },
          "importance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Importance"
          }
        },
        "type": "object",
        "title": "GraphNodeUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryContext": {
        "properties": {
          "qdrant_context": {
            "items": {
              "$ref": "#/components/schemas/RetrievedMemory"
            },
            "type": "array",
            "title": "Qdrant Context"
