# App Settings
APP_NAME="Personia AI"
ENVIRONMENT="development"
DEBUG=True
USER_TIMEZONE="Asia/Jakarta"

# Local web retrieval (SearXNG runs through docker-compose)
WEB_SEARCH_ENABLED=True
SEARXNG_URL="http://127.0.0.1:8088"
WEB_SEARCH_TIMEOUT_SECONDS=3.5
WEB_SEARCH_MAX_RESULTS=6
WEB_TOOL_MAX_ROUNDS=3
WEB_TOOL_PLANNING_TIMEOUT_SECONDS=20
WEB_READ_MAX_URLS=2
WEB_READ_MAX_CHARS=5000
WEB_READ_TIMEOUT_SECONDS=15
JINA_READER_URL="https://r.jina.ai"
# Optional: raises Jina Reader rate limits. Basic usage works without a key.
JINA_API_KEY=""

# LLM API
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY=""
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# Memory intelligence (OpenAI-compatible provider; optional fallback)
MEMORY_LLM_PROVIDER="google"
MEMORY_LLM_MODEL="gemini-3.1-flash-lite"
MEMORY_LLM_FALLBACK_PROVIDER=""
MEMORY_LLM_FALLBACK_MODEL=""
MEMORY_LLM_TIMEOUT_SECONDS=15
MEMORY_LLM_MAX_RETRIES=0
MEMORY_FACT_CONFIDENCE_THRESHOLD=0.70

# Database Configuration (Neo4j)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="personia_secret"

# Database Configuration (SQLite)
# Menggunakan absolute atau relative path. Disini akan disimpan di backend/data/
DATABASE_URL="sqlite:///./data/personia.db"

# Qdrant Storage (Local Embedded)
QDRANT_PATH="./data/qdrant"
QDRANT_MEMORY_COLLECTION="personia_memory_e5_v1"
EMBEDDING_MODEL_NAME="intfloat/multilingual-e5-large"
# Pin a cached model revision when replacing weights under the same model name.
EMBEDDING_MODEL_REVISION=""
EMBEDDING_INIT_RETRY_BASE_SECONDS=2
EMBEDDING_INIT_RETRY_MAX_SECONDS=60
MEMORY_SEARCH_SCORE_THRESHOLD=0.75
MEMORY_RETRIEVAL_TIMEOUT_SECONDS=6
MEMORY_RETRIEVAL_WORKERS=8
CHAT_INPUT_TOKEN_BUDGET=24000
CHAT_OUTPUT_MAX_TOKENS=2048
TURN_LEASE_SECONDS=300
